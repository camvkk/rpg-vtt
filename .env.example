# Porta do servidor (o cliente de desenvolvimento usa 5173 e faz proxy para cá)
PORT=3001

# Onde ficam o banco SQLite e os uploads. Em produção, aponte para um disco PERSISTENTE.
DATA_DIR=./data

# Oráculo (IA) — use UMA das chaves abaixo (Kimi K2.5)
# MOONSHOT_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=kimi-k2.5

# Só se o cliente for hospedado em outro domínio (ex: Vercel) — lista separada por vírgulas
# CORS_ORIGINS=https://minha-mesa.vercel.app

# Sem disco persistente (ex: Render grátis)? Guarde banco + uploads num bucket S3 (ex: Backblaze B2).
# O bucket vira a fonte da verdade: ao ligar, o banco local é SUBSTITUÍDO pelo do bucket.
# Nunca use o mesmo bucket em dois servidores ao mesmo tempo.
# S3_ENDPOINT=s3.us-east-005.backblazeb2.com
# S3_BUCKET=minha-mesa
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=        (deduzida do endpoint; R2 usa auto)
# S3_PREFIX=        (pasta dentro do bucket, opcional)
# SNAPSHOT_INTERVAL_MS=30000

# Limites de upload
# MAX_UPLOAD_MB=30
# CAMPAIGN_QUOTA_MB=500
