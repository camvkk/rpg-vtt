{
  "name": "rpg-vtt",
  "version": "2.0.0",
  "private": true,
  "description": "RPG VTT v2 — mesa virtual dark fantasy para D&D 5e: mapa com iluminação dinâmica, dados 3D, fichas automáticas, combate e Mestre-IA.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch --watch-path=server --watch-path=shared server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "play": "npm run build && node --disable-warning=ExperimentalWarning server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"client/src/features/dice3d/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "cannon-es": "^0.20.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.58.0",
    "marked": "^18.1.1",
    "motion": "^14.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
